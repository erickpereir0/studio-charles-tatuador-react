{
  "name": "Estúdio de Charles tatuador - React",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Estúdio de Charles tatuador",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-CEINTL.vscode-language-pack-pt-BR"
      ],
      "settings": {
        "editor.tabSize": 2
      }
    }
  }
}
